RewriteEngine On

# Redirect non-www to www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [L,R=301]

# (Optional: HTTPS redirect — only after fixing SSL)

# Redirect old .html to clean URLs
RewriteCond %{THE_REQUEST} \s/([^\s]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Show .html without extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect /home to /index
RewriteRule ^home$ /index [L,NC]

# Custom 404
ErrorDocument 404 https://www.heavenscake.ct.ws/404